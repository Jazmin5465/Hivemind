# Copy to .env (gitignored). Never commit real keys.

# SpacetimeDB (local)
SPACETIME_URI=ws://127.0.0.1:3000
SPACETIME_DB=hivemind
# Optional: token for the worker identity. If empty, the worker reads the
# spacetime CLI token (~/.config/spacetime/cli.toml), i.e. the publisher identity.
SPACETIME_TOKEN=

# Hadent's ML sidecar (ml/serve.py)
ML_URL=http://127.0.0.1:8001
ML_ENABLED=true

# LLM for the Nemotron agent: brev | nvidia_hosted | template
LLM_PROVIDER=template
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-nano-3-30b-a3b
LLM_API_KEY=
NVIDIA_API_KEY=
LLM_TEMPERATURE=1.0
LLM_TOP_P=0.95
LLM_ENABLE_THINKING=false

# shared secret the worker uses to register with the module (scripts/setup-local.sh generates it)
WORKER_KEY=
